Cell[BoxData[
 RowBox[{"sol", " ", "=", " ", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"n", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", "4"}], " ", 
        RowBox[{"Pi", "/", "\[Tau]"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"n", "[", "t", "]"}]}], ")"}], 
        RowBox[{"n", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"n", "[", "0", "]"}], "==", "n0"}]}], "}"}], ",", 
    RowBox[{"n", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"0f6dc182-2ceb-44e8-87e5-878989137db3"],

