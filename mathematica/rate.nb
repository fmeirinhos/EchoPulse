 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"t_", ",", " ", "\[Tau]_", ",", " ", "n0_"}], "]"}], "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"n", "[", "t", "]"}], "/.", 
     RowBox[{"sol", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ",", "t"}], "]"}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"27aa51bb-c658-4054-848e-4056d86dcb33"],

