Cell[BoxData[
 RowBox[{"$Assumptions", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Sigma]", ">", "0"}], ",", " ", 
    RowBox[{"x0", " ", "\[Element]", "Reals"}], ",", " ", 
    RowBox[{"n0", "\[Element]", "Reals"}]}], "}"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"fd4859bb-da91-476f-a164-487027b65d47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Xi]", "[", 
   RowBox[{"x_", ",", "x0_", ",", "\[Sigma]_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "Pi", " ", 
      RowBox[{"\[Sigma]", "^", "2"}]}], "]"}]}], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "x0"}], ")"}], "^", "2"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"82d6b185-4843-4605-a730-c446b326811a"],

